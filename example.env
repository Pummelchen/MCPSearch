# SwiftWebSearchMCP example configuration.
#
# Copy to `config.env` next to the executable, or point SEARCH_CONFIG_FILE at it.
# Environment variables always override values in this file.
#
# The server starts with no credentials at all; every key below is optional.
# Provide at least one search provider, or web_search will explain what is missing.

# ---------------------------------------------------------------------------
# Provider credentials and endpoints
# ---------------------------------------------------------------------------

# Tavily — AI-oriented search. 1,000 free credits/month, 1 credit per basic search.
# TAVILY_API_KEY=tvly-...

# Brave Search — broad independent index. Monthly free credit allowance.
# BRAVE_SEARCH_API_KEY=...

# Mojeek — independent crawler index. Paid API with a limited trial; useful for
# index diversity rather than as a free tier. Authenticates via a query parameter.
# MOJEEK_API_KEY=...

# Exa — neural/semantic retrieval with agent-oriented highlights. Signup credit
# plus a monthly free allowance.
# EXA_API_KEY=...

# Jina — used for the page-extraction fallback by default. A key raises the rate
# limit but is not required for reader-style fetches.
# JINA_API_KEY=jina_...

# SearXNG — self-hosted metasearch. The best no-vendor-account path.
# IMPORTANT: your instance must enable JSON output. The shipped settings.yml
# enables only `html`, so set `search.formats: [html, json]` or format=json
# returns HTTP 403.
# SEARXNG_BASE_URL=https://searx.example.com

# Open Web Search — a multi-engine aggregation endpoint. This is an aggregator,
# not an index, so its results are discounted during fusion. No authoritative
# public specification could be verified; supply your own endpoint.
# OPEN_WEB_SEARCH_URL=https://aggregator.example.com/search

# Parallel Search MCP — anonymous upstream MCP search service. Requires
# SEARCH_ENABLE_PARALLEL=true to be used.
# PARALLEL_MCP_URL=https://search.parallel.ai/mcp

# ---------------------------------------------------------------------------
# Policy
# ---------------------------------------------------------------------------

# Preference order for provider=auto. Direct indexes are preferred over
# aggregators, and opt-in scrapers are used last regardless of this list.
# SEARCH_PROVIDER_ORDER=tavily,brave,mojeek,exa,searxng,open_web_search,duckduckgo,startpage,parallel

# Comma-separated providers to switch off entirely.
# SEARCH_DISABLED_PROVIDERS=

# SEARCH_MAX_RESULTS=8

# Per-mode wall-clock budgets for a whole search.
# SEARCH_FAST_TIMEOUT_MS=12000
# SEARCH_BALANCED_TIMEOUT_MS=15000
# SEARCH_THOROUGH_TIMEOUT_MS=20000

# HTML scrapers are undocumented and change without notice. Off by default.
# DuckDuckGo answers automated requests with a bot challenge (HTTP 202).
# Startpage serves an Anubis proof-of-work challenge that a plain HTTP client
# cannot solve, so it will usually report itself unavailable.
# SEARCH_ENABLE_SCRAPERS=false

# Enable the upstream Parallel Search MCP adapter.
# SEARCH_ENABLE_PARALLEL=false

# Fall back to Jina Reader when native extraction yields too little text.
# SEARCH_ENABLE_JINA_READER=true

# In-memory search cache lifetime. 0 disables caching.
# SEARCH_CACHE_TTL_SECONDS=120

# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------

# SEARCH_CONNECT_TIMEOUT_MS=3000
# SEARCH_REQUEST_TIMEOUT_MS=10000
# SEARCH_MAX_RETRIES=2
# SEARCH_USER_AGENT=SwiftWebSearchMCP/1.0 (+https://example.invalid/project)

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------

# Allows web_open to fetch private, loopback, link-local and metadata addresses.
# Only enable this if you deliberately want models to reach internal hosts.
# SEARCH_ALLOW_PRIVATE_NETWORK=false

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

# trace | debug | info | warning | error | none
# SEARCH_LOG_LEVEL=info

# Log queries verbatim instead of a stable hash. Off by default so search terms
# do not end up in logs.
# SEARCH_LOG_QUERIES=false
