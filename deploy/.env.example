# Local, git-ignored values for deploy/docker-compose.yml.
#
# `docker compose` loads this file automatically when it is named `.env` next to the compose
# file or in the working directory, so:
#
#     cp deploy/.env.example deploy/.env
#     printf 'SEARXNG_SECRET=%s\n' "$(openssl rand -hex 32)" >> deploy/.env
#     docker compose -f deploy/docker-compose.yml up -d
#
# `.env` is covered by the `*.env` rule in .gitignore; nothing in this file should ever be
# committed with a real value in it.

# The SearXNG session-signing key. Required: the compose file fails closed without it, and so
# does SearXNG itself if `server.secret_key` ends up unset. Generate one, do not invent one:
#
#     openssl rand -hex 32
SEARXNG_SECRET=
